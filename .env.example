# Shared database for future backend + existing Prisma preview.
DATABASE_URL="postgresql://scode:scode_password@localhost:5432/scode_finance?schema=public"

# Existing NextAuth preview. Keep while Next.js remains in repo.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

DEMO_ADMIN_EMAIL="admin@scode.com"
DEMO_ADMIN_PASSWORD="admin123456"

# Future Express backend. Backend Fase 1 is isolated and not wired to the frontend yet.
BACKEND_PORT=4000
BACKEND_NODE_ENV=development
BACKEND_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
