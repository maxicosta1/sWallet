# Shared MySQL/MariaDB database for future backend + existing Prisma preview.
DATABASE_URL="mysql://user:password@localhost:3306/database_name"

# Existing NextAuth preview. Keep while Next.js remains in repo.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Express backend.
BACKEND_PORT=4000
BACKEND_NODE_ENV=development
BACKEND_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ALLOWED_LOGIN_USERS="FranPernil,MaxiTaxi"
ALLOWED_LOGIN_PASSWORD="replace-with-a-private-password"
