generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  finanzas
  project_manager
  desarrollador
  marketing
  solo_lectura
  cliente
}

enum UserStatus {
  activo
  inactivo
  invitado
}

enum Currency {
  ARS
  USD
}

enum ClientStatus {
  lead
  interesado
  activo
  cliente_activo
  en_negociacion
  en_desarrollo
  mantenimiento
  proyecto_finalizado
  finalizado
}

enum Priority {
  baja
  media
  alta
  urgente
}

enum PaymentStatus {
  pendiente
  pagado
  vencido
  cancelado
}

enum InvoiceStatus {
  borrador
  pendiente
  enviada
  pagada
  vencida
  cancelada
}

enum PaymentMethod {
  transferencia
  efectivo
  mercadopago
  paypal
  wise
  stripe
  otro
}

enum MovementType {
  ingreso
  gasto
  salida
  inversion
}

enum ProjectStatus {
  pendiente
  planificacion
  en_progreso
  en_desarrollo
  revision
  en_revision
  entregado
  pausado
  finalizado
}

enum ProjectStage {
  relevamiento
  diseno
  desarrollo
  revision_interna
  revision_cliente
  correcciones
  entrega
  mantenimiento
}

enum ProjectRisk {
  normal
  en_riesgo
  atrasado
  bloqueado_cliente
  bloqueado_interno
}

enum SubscriptionStatus {
  activa
  por_vencer
  vencida
  cancelada
}

enum TaskStatus {
  pendiente
  en_proceso
  en_revision
  bloqueada
  completada
  cancelada
}

enum GoalStatus {
  en_progreso
  cumplida
  pausada
  cancelada
}

enum BudgetStatus {
  borrador
  enviado
  aprobado
  rechazado
  vencido
}

enum CalendarEventStatus {
  pendiente
  confirmado
  completado
  cancelado
}

enum OpportunityStatus {
  nuevo
  contacto
  reunion_agendada
  negociacion
  ganado
  perdido
}

enum DocumentType {
  brief
  contrato
  factura
  propuesta
  recurso
  otro
}

enum PortalItemStatus {
  visible
  oculto
  archivado
}

enum ActivityType {
  creado
  actualizado
  eliminado
  pago_registrado
  nota
  archivo
  estado
  login
  importacion
  exportacion
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  username           String?             @unique
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               Role                @default(solo_lectura)
  status             UserStatus          @default(activo)
  permissions        Json?
  phone              String?
  area               String?
  notes              String?             @db.Text
  accounts           Account[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  clients            Client[]
  projects           Project[]
  invoices           Invoice[]
  payments           Payment[]
  movements          Movement[]
  subscriptions      Subscription[]
  tasks              AdminTask[]
  goals              Goal[]
  serviceRequests    ServiceRequest[]
  internalNotes      InternalNote[]
  nextActions        NextAction[]
  opportunities      Opportunity[]
  budgets            Budget[]
  calendarEvents     CalendarEvent[]
  documents          Document[]
  supportPlans       SupportPlan[]
  teamMembers        TeamMember[]
  marketingCampaigns MarketingCampaign[]
  clientPortalItems  ClientPortalItem[]
  activities         ActivityLog[]
  notesAuthored      ClientNote[]
  dashboardWidgets   DashboardWidget[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id             String             @id @default(cuid())
  userId         String?
  legacyId       String?            @unique
  name           String
  company        String
  email          String
  phone          String
  address        String?
  socials        String?
  website        String?
  service        String
  agreedPrice    Decimal            @db.Decimal(14, 2)
  currency       Currency           @default(ARS)
  status         ClientStatus       @default(lead)
  priority       Priority           @default(media)
  firstContact   DateTime?
  lastContact    DateTime?
  startDate      DateTime?
  observations   String?            @db.Text
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  payments       Payment[]
  projects       Project[]
  movements      Movement[]
  tasks          AdminTask[]
  goals          Goal[]
  requests       ServiceRequest[]
  internalNotes  InternalNote[]
  nextActions    NextAction[]
  opportunities  Opportunity[]
  budgets        Budget[]
  calendarEvents CalendarEvent[]
  documents      Document[]
  supportPlans   SupportPlan[]
  portalItems    ClientPortalItem[]
  notes          ClientNote[]
  attachments    Attachment[]
  activities     ActivityLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([company])
  @@index([email])
}

model Project {
  id             String             @id @default(cuid())
  userId         String?
  clientId       String
  approvedBudgetId String?          @unique
  responsibleTeamMemberId String?
  legacyId       String?            @unique
  name           String
  description    String?            @db.Text
  status         ProjectStatus      @default(pendiente)
  stage          ProjectStage       @default(relevamiento)
  risk           ProjectRisk        @default(normal)
  progress       Int                @default(0)
  budget         Decimal            @db.Decimal(14, 2)
  paid           Decimal            @default(0) @db.Decimal(14, 2)
  expenses       Decimal            @default(0) @db.Decimal(14, 2)
  currency       Currency           @default(ARS)
  responsible    String?
  technologies   String?
  links          String?            @db.Text
  notes          String?            @db.Text
  scope          Json?
  startsAt       DateTime?
  dueAt          DateTime?
  deliveredAt    DateTime?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  client         Client             @relation(fields: [clientId], references: [id])
  approvedBudget Budget?            @relation("ApprovedBudget", fields: [approvedBudgetId], references: [id], onDelete: SetNull)
  responsibleTeamMember TeamMember? @relation("ProjectResponsible", fields: [responsibleTeamMemberId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  payments       Payment[]
  movements      Movement[]
  tasks          ProjectTask[]
  adminTasks     AdminTask[]
  goals          Goal[]
  requests       ServiceRequest[]
  internalNotes  InternalNote[]
  nextActions    NextAction[]
  budgets        Budget[]
  calendarEvents CalendarEvent[]
  documents      Document[]
  supportPlans   SupportPlan[]
  attachments    Attachment[]
  timeEntries     TimeEntry[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([approvedBudgetId])
  @@index([responsibleTeamMemberId])
  @@index([status])
  @@index([stage])
  @@index([risk])
  @@index([dueAt])
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  completed   Boolean   @default(false)
  position    Int       @default(0)
  dueAt       DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String?
  clientId    String
  projectId   String?
  budgetId    String?
  legacyId    String?       @unique
  number      String
  amount      Decimal       @db.Decimal(14, 2)
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  discount    Decimal       @default(0) @db.Decimal(14, 2)
  taxes       Decimal       @default(0) @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue  Decimal       @default(0) @db.Decimal(14, 2)
  currency    Currency      @default(ARS)
  issueDate   DateTime
  dueDate     DateTime
  status      InvoiceStatus @default(pendiente)
  notes       String?       @db.Text
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client        @relation(fields: [clientId], references: [id])
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budget      Budget?       @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  movements   Movement[]
  attachments Attachment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@unique([number])
  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([budgetId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id            String               @id @default(cuid())
  userId        String?
  clientId      String
  projectId     String?
  invoiceId     String?
  budgetId      String?
  legacyId      String?              @unique
  amount        Decimal              @db.Decimal(14, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(14, 2)
  currency      Currency             @default(ARS)
  date          DateTime
  dueDate       DateTime
  status        PaymentStatus        @default(pendiente)
  method        PaymentMethod        @default(transferencia)
  isRecurring   Boolean              @default(false)
  recurringRule String?
  notes         String?              @db.Text
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  client        Client               @relation(fields: [clientId], references: [id])
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  budget        Budget?              @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  movement      Movement?            @relation("PaymentMovement")
  installments  PaymentInstallment[]
  attachments   Attachment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([budgetId])
  @@index([status])
  @@index([dueDate])
}

model PaymentInstallment {
  id        String        @id @default(cuid())
  paymentId String
  amount    Decimal       @db.Decimal(14, 2)
  currency  Currency      @default(ARS)
  paidAt    DateTime
  method    PaymentMethod @default(transferencia)
  notes     String?
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([paymentId])
}

model Movement {
  id          String       @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  paymentId   String?      @unique
  invoiceId   String?
  legacyId    String?      @unique
  type        MovementType
  categoryId  String
  description String       @db.Text
  amount      Decimal      @db.Decimal(14, 2)
  currency    Currency     @default(ARS)
  date        DateTime
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payment     Payment?     @relation("PaymentMovement", fields: [paymentId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id])
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([categoryId])
  @@index([type])
  @@index([date])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String?
  legacyId    String?            @unique
  name        String
  provider    String
  category    String
  monthlyCost Decimal            @db.Decimal(14, 2)
  annualCost  Decimal            @db.Decimal(14, 2)
  currency    Currency           @default(ARS)
  renewsAt    DateTime
  status      SubscriptionStatus @default(activa)
  notes       String?            @db.Text
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([renewsAt])
  @@index([status])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String
  icon      String?
  movements Movement[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
}

model AdminTask {
  id          String     @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  responsibleTeamMemberId String?
  legacyId    String?    @unique
  title       String
  description String?    @db.Text
  responsible String?
  priority    Priority   @default(media)
  status      TaskStatus @default(pendiente)
  dueDate     DateTime?
  checklist   Json?
  comments    String?    @db.Text
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleTeamMember TeamMember? @relation("TaskResponsible", fields: [responsibleTeamMemberId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([responsibleTeamMemberId])
  @@index([status])
  @@index([dueDate])
}

model Goal {
  id        String     @id @default(cuid())
  userId    String?
  clientId  String?
  projectId String?
  legacyId  String?    @unique
  name      String
  period    String
  type      String
  target    Decimal    @db.Decimal(14, 2)
  current   Decimal    @default(0) @db.Decimal(14, 2)
  dueDate   DateTime?
  status    GoalStatus @default(en_progreso)
  priority  Priority   @default(media)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model ServiceRequest {
  id          String     @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  responsibleTeamMemberId String?
  legacyId    String?    @unique
  description String     @db.Text
  type        String
  date        DateTime
  status      TaskStatus @default(pendiente)
  priority    Priority   @default(media)
  responsible String?
  dueDate     DateTime?
  notes       String?    @db.Text
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleTeamMember TeamMember? @relation("ServiceRequestResponsible", fields: [responsibleTeamMemberId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([responsibleTeamMemberId])
  @@index([status])
}

model InternalNote {
  id        String   @id @default(cuid())
  userId    String?
  clientId  String?
  projectId String?
  legacyId  String?  @unique
  title     String
  content   String   @db.Text
  date      DateTime
  tone      String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([date])
}

model NextAction {
  id        String     @id @default(cuid())
  userId    String?
  clientId  String?
  projectId String?
  legacyId  String?    @unique
  title     String
  dueDate   DateTime?
  priority  Priority   @default(media)
  status    TaskStatus @default(pendiente)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model Opportunity {
  id          String            @id @default(cuid())
  userId      String?
  clientId    String?
  campaignId  String?
  responsibleTeamMemberId String?
  legacyId    String?           @unique
  title       String
  service     String
  value       Decimal           @db.Decimal(14, 2)
  currency    Currency          @default(ARS)
  probability Int               @default(0)
  status      OpportunityStatus @default(nuevo)
  nextAction  String?
  responsible String?
  notes       String?           @db.Text
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  responsibleTeamMember TeamMember? @relation("OpportunityResponsible", fields: [responsibleTeamMemberId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([campaignId])
  @@index([responsibleTeamMemberId])
  @@index([status])
}

model Budget {
  id          String       @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  legacyId    String?      @unique
  number      String?      @unique
  projectName String
  services    String?      @db.Text
  subtotal    Decimal      @default(0) @db.Decimal(14, 2)
  discount    Decimal      @default(0) @db.Decimal(14, 2)
  taxes       Decimal      @default(0) @db.Decimal(14, 2)
  total       Decimal      @default(0) @db.Decimal(14, 2)
  currency    Currency     @default(ARS)
  issueDate   DateTime     @default(now())
  validUntil  DateTime?
  status      BudgetStatus @default(borrador)
  notes       String?      @db.Text
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvedProject Project? @relation("ApprovedBudget")
  invoices    Invoice[]
  payments    Payment[]
  items       BudgetItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([number])
  @@index([status])
  @@index([validUntil])
}

model BudgetItem {
  id          String   @id @default(cuid())
  budgetId    String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @default(0) @db.Decimal(14, 2)
  position    Int      @default(0)
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([budgetId])
}

model CalendarEvent {
  id          String              @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  legacyId    String?             @unique
  title       String
  type        String
  date        DateTime
  startTime   String?
  endTime     String?
  status      CalendarEventStatus @default(pendiente)
  priority    Priority            @default(media)
  description String?             @db.Text
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Document {
  id          String       @id @default(cuid())
  userId      String?
  clientId    String?
  projectId   String?
  legacyId    String?      @unique
  name        String
  type        DocumentType @default(otro)
  link        String
  tags        String?
  description String?      @db.Text
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([type])
}

model SupportPlan {
  id             String    @id @default(cuid())
  userId         String?
  clientId       String?
  projectId      String?
  legacyId       String?   @unique
  url            String
  domain         String
  hosting        String
  domainRenewal  DateTime?
  hostingRenewal DateTime?
  plan           String
  monthlyPrice   Decimal   @db.Decimal(14, 2)
  currency       Currency  @default(ARS)
  status         String
  notes          String?   @db.Text
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model TeamMember {
  id              String           @id @default(cuid())
  userId          String?
  legacyId        String?          @unique
  name            String
  lastName        String?
  email           String
  phone           String?
  role            String
  status          UserStatus       @default(activo)
  focus           String?
  responsibilities String?         @db.Text
  notes           String?          @db.Text
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  responsibleProjects Project[]    @relation("ProjectResponsible")
  assignedTasks   AdminTask[]      @relation("TaskResponsible")
  serviceRequests ServiceRequest[] @relation("ServiceRequestResponsible")
  opportunities   Opportunity[]    @relation("OpportunityResponsible")
  timeEntries     TimeEntry[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([email])
  @@index([status])
}

model TimeEntry {
  id           String     @id @default(cuid())
  teamMemberId String
  projectId    String?
  taskId       String?
  date         DateTime
  hours        Decimal    @db.Decimal(10, 2)
  comment      String?    @db.Text
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         AdminTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([teamMemberId])
  @@index([projectId])
  @@index([taskId])
  @@index([date])
}

model MarketingCampaign {
  id        String   @id @default(cuid())
  userId    String?
  legacyId  String?  @unique
  name      String
  target    String
  message   String   @db.Text
  contacts  Int      @default(0)
  responses Int      @default(0)
  meetings  Int      @default(0)
  sales     Int      @default(0)
  status    String
  date      DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([date])
}

model ClientPortalItem {
  id        String           @id @default(cuid())
  userId    String?
  clientId  String
  legacyId  String?          @unique
  title     String
  type      String
  status    PortalItemStatus @default(visible)
  link      String?
  notes     String?          @db.Text
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
}

model CompanySettings {
  id                String   @id @default(cuid())
  name              String   @default("sCode Digital Solutions")
  legalName         String?
  email             String?
  website           String?
  primaryColor      String   @default("#9f5cff")
  mainCurrency      Currency @default(ARS)
  secondaryCurrency Currency @default(USD)
  reminderDays      Int      @default(5)
  services          String?  @db.Text
  financeCategories String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Attachment {
  id         String    @id @default(cuid())
  fileName   String
  url        String
  mimeType   String
  size       Int
  clientId   String?
  projectId  String?
  invoiceId  String?
  paymentId  String?
  movementId String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment    Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  movement   Movement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([movementId])
}

model ClientNote {
  id        String    @id @default(cuid())
  clientId  String
  userId    String
  body      String    @db.Text
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([userId])
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String?
  clientId   String?
  entityType String?
  entityId   String?
  type       ActivityType
  title      String
  body       String?
  metadata   Json?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      Currency @default(USD)
  quote     Currency @default(ARS)
  rate      Decimal  @db.Decimal(14, 4)
  source    String   @default("manual")
  validAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([validAt])
  @@unique([base, quote, validAt])
}

model DashboardWidget {
  id        String   @id @default(cuid())
  userId    String?
  key       String
  title     String
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  config    Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, key])
}

model AppSnapshot {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
